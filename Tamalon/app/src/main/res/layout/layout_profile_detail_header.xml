<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <android.widget.Button
        android:id="@+id/back_to_profile"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@color/tamalon_transparent"
        android:drawableStart="@drawable/ic_arrow"
        android:drawablePadding="6dp"
        android:fontFamily="@font/inter"
        android:text="Volver a mi perfil"
        android:textAllCaps="false"
        android:textColor="@color/tamalon_field_text"
        android:textSize="9sp" 
            android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/detail_eyebrow"
            style="@style/Tamalon.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="TU INFORMACIÓN" />

        <TextView
            android:id="@+id/detail_title"
            style="@style/Tamalon.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Datos Personales"
            android:textColor="@color/tamalon_ink"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/detail_description"
            style="@style/Tamalon.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingMultiplier="1.3"
            android:text="Administra la información asociada a tu cuenta." />
    </LinearLayout>
</LinearLayout>
