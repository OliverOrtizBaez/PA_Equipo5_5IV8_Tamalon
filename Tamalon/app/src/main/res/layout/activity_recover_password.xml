<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperación de contraseña. Integración: Supabase Auth → envía correo con token de 30 min. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tamalon_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_horizontal"
        android:paddingTop="@dimen/screen_top"
        android:paddingBottom="32dp">

        <android.widget.Button
            android:id="@+id/recover_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@color/tamalon_transparent"
            android:drawableStart="@drawable/ic_arrow"
            android:drawablePadding="6dp"
            android:text="@string/btn_back"
            android:textAllCaps="false"
            android:textColor="@color/tamalon_field_text"
            android:textSize="9sp" 
            android:visibility="gone" />

        <TextView
            style="@style/Tamalon.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/recover_title"
            android:textColor="@color/tamalon_ink"
            android:textSize="22sp" />

        <TextView
            style="@style/Tamalon.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recover_instructions"
            android:textSize="10sp" />

        <TextView
            style="@style/Tamalon.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_email_label" />

        <EditText
            android:id="@+id/recover_email"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input"
            android:hint="@string/login_email_hint"
            android:inputType="textEmailAddress"
            android:padding="10dp"
            android:textSize="10sp" />

        <!-- Estado (sending / success / error) -->
        <TextView
            android:id="@+id/recover_status"
            style="@style/Tamalon.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface_card"
            android:padding="10dp"
            android:text=""
            android:textSize="9sp"
            android:visibility="gone" />

        <android.widget.Button
            android:id="@+id/recover_submit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:fontFamily="@font/inter"
            android:text="@string/recover_submit"
            android:textAllCaps="false"
            android:textColor="@color/tamalon_field_text"
            android:textSize="11sp" />

        <TextView
            style="@style/Tamalon.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/recover_backend_note"
            android:textSize="8sp" />
    </LinearLayout>
</ScrollView>
