<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo público del Vendedor visto por el Cliente.
     Gratuito: nombre, imagen, categoría.   Premium: + precio + descripción. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tamalon_background"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_horizontal"
        android:paddingTop="@dimen/screen_top"
        android:paddingBottom="8dp">

        <android.widget.Button
            android:id="@+id/catalog_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@color/tamalon_transparent"
            android:drawableStart="@drawable/ic_arrow"
            android:drawablePadding="6dp"
            android:text="@string/btn_back"
            android:textAllCaps="false"
            android:textColor="@color/tamalon_field_text"
            android:textSize="9sp" 
            android:visibility="gone" />

        <TextView
            android:id="@+id/catalog_vendor_name"
            style="@style/Tamalon.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/profile_user_placeholder"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Aviso plan gratuito (visible si el cliente no es premium) -->
    <TextView
        android:id="@+id/catalog_upgrade_notice"
        style="@style/Tamalon.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_yellow"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/catalog_upgrade_notice"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- Lista de productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/catalog_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/screen_horizontal"
        android:paddingTop="8dp"
        android:clipToPadding="false" />

    <!-- Estado vacío -->
    <TextView
        android:id="@+id/catalog_empty"
        style="@style/Tamalon.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/catalog_empty"
        android:visibility="gone" />
</LinearLayout>
