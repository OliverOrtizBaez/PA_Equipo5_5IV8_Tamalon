<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tamalon_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="170dp"
            android:layout_height="176dp"
            android:contentDescription="@string/login_illustration_desc"
            android:scaleType="centerCrop"
            android:tint="@color/logo_tint"
            android:src="@drawable/tamalon_illustration" />

        <LinearLayout
            android:layout_width="258dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_surface_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="23dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Tamalon.BrandText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                style="@style/Tamalon.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="@string/login_title"
                android:textSize="15sp" />

            <TextView
                style="@style/Tamalon.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/login_email_label" />

            <EditText
                android:id="@+id/login_email"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_input"
                android:fontFamily="sans"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="10dp"
                android:textColor="@color/tamalon_field_text"
                android:textSize="10sp" />

            <TextView
                style="@style/Tamalon.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/login_password_label" />

            <EditText
                android:id="@+id/login_password"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_input"
                android:fontFamily="sans"
                android:inputType="textPassword"
                android:hint="@string/login_password_hint"
                android:paddingHorizontal="10dp"
                android:textColor="@color/tamalon_field_text"
                android:textSize="10sp" />

            <!-- Error de credenciales -->
            <TextView
                android:id="@+id/login_error"
                style="@style/Tamalon.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/tamalon_error"
                android:textSize="8sp"
                android:visibility="gone" />

            <android.widget.Button
                android:id="@+id/login_submit"
                android:layout_width="128dp"
                android:layout_height="42dp"
                android:layout_marginTop="21dp"
                android:background="@drawable/bg_button"
            android:backgroundTint="@null"
                android:fontFamily="@font/inter"
                android:text="@string/login_submit"
                android:textAllCaps="false"
                android:textColor="@color/tamalon_field_text"
                android:textSize="10sp" />

            <android.widget.Button
                android:id="@+id/login_forgot"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_text_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/inter"
                android:text="@string/login_forgot"
                android:textAllCaps="false"
                android:textColor="@color/tamalon_link_text"
                android:textSize="8sp" />

            <android.widget.Button
                android:id="@+id/show_register"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_text_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/inter"
                android:text="@string/login_no_account"
                android:textAllCaps="false"
                android:textColor="@color/tamalon_link_text"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
