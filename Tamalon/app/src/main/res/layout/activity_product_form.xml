<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario de creación / edición de Producto. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tamalon_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_horizontal"
        android:paddingTop="@dimen/screen_top"
        android:paddingBottom="32dp">

        <android.widget.Button
            android:id="@+id/product_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@color/tamalon_transparent"
            android:drawableStart="@drawable/ic_arrow"
            android:drawablePadding="6dp"
            android:text="@string/btn_back"
            android:textAllCaps="false"
            android:textColor="@color/tamalon_field_text"
            android:textSize="9sp" 
            android:visibility="gone" />

        <TextView
            android:id="@+id/product_form_title"
            style="@style/Tamalon.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/product_form_add_title"
            android:textColor="@color/tamalon_ink"
            android:textSize="22sp" />

        <!-- Imagen del producto -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surface_card"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/product_image_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/product_image_label"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_placeholder"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/product_image_hint"
                style="@style/Tamalon.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/product_image_tap"
                android:textSize="9sp" />

            <!-- Botón seleccionar imagen -->
            <android.widget.Button
                android:id="@+id/product_btn_pick_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tamalon_transparent"
                android:text="" />
        </FrameLayout>

        <TextView
            android:id="@+id/product_image_error"
            style="@style/Tamalon.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textColor="@color/tamalon_error"
            android:textSize="8sp"
            android:visibility="gone" />

        <!-- Nombre -->
        <TextView
            style="@style/Tamalon.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/product_name_label" />

        <EditText
            android:id="@+id/product_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input"
            android:hint="@string/product_name_hint"
            android:inputType="textCapWords"
            android:maxLength="60"
            android:padding="10dp"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/product_name_error"
            style="@style/Tamalon.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textColor="@color/tamalon_error"
            android:textSize="8sp"
            android:visibility="gone" />

        <!-- Descripción -->
        <TextView
            style="@style/Tamalon.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/product_description_label" />

        <EditText
            android:id="@+id/product_description"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="@string/product_description_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="300"
            android:padding="10dp"
            android:textSize="10sp" />

        <!-- Precio -->
        <TextView
            style="@style/Tamalon.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/product_price_label" />

        <EditText
            android:id="@+id/product_price"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/product_price_error"
            style="@style/Tamalon.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textColor="@color/tamalon_error"
            android:textSize="8sp"
            android:visibility="gone" />

        <!-- Categoría -->
        <TextView
            style="@style/Tamalon.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/product_category_label" />

        <Spinner
            android:id="@+id/product_category"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp" />

        <!-- Visible en catálogo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Tamalon.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/product_visible_label"
                android:textSize="10sp" />

            <Switch
                android:id="@+id/product_visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Error global -->
        <TextView
            android:id="@+id/product_global_error"
            style="@style/Tamalon.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_card"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/tamalon_error"
            android:textSize="9sp"
            android:visibility="gone" />

        <!-- Guardar -->
        <android.widget.Button
            android:id="@+id/product_btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:fontFamily="@font/inter"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textColor="@color/tamalon_field_text"
            android:textSize="11sp" />

        <!-- Eliminar (solo en modo edición) -->
        <android.widget.Button
            android:id="@+id/product_btn_delete"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_surface_card"
            android:fontFamily="@font/inter"
            android:text="@string/product_btn_delete"
            android:textAllCaps="false"
            android:textColor="@color/tamalon_error"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
