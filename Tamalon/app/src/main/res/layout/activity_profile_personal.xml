<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tamalon_background"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_horizontal" android:paddingTop="@dimen/screen_top" android:paddingBottom="30dp">
        <include layout="@layout/layout_profile_app_header" />
        <android.widget.Button android:id="@+id/back_to_profile" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@color/tamalon_transparent" android:drawableStart="@drawable/ic_arrow" android:drawablePadding="6dp" android:text="Volver a mi perfil" android:textAllCaps="false" android:textColor="@color/tamalon_field_text" android:textSize="9sp" 
            android:visibility="gone" />

        <LinearLayout style="@style/Tamalon.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/Tamalon.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="TU INFORMACIÓN" />
            <TextView style="@style/Tamalon.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Datos Personales" android:textColor="@color/tamalon_ink" android:textSize="24sp" />
            <TextView style="@style/Tamalon.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Administra los datos asociados a tu cuenta de Tamalón." />
        </LinearLayout>

        <LinearLayout style="@style/Tamalon.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
            <ImageView android:id="@+id/personal_avatar" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_circle" android:clipToOutline="true" android:contentDescription="Foto de perfil" android:scaleType="centerCrop" android:src="@drawable/ic_user" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Tamalon.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Foto de perfil" android:textStyle="bold" />
                <TextView style="@style/Tamalon.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Elige una imagen de tu dispositivo." />
                <android.widget.Button android:id="@+id/choose_profile_photo" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="7dp" android:background="@drawable/bg_button" android:text="Cambiar foto" android:textAllCaps="false" android:textColor="@color/tamalon_field_text" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Tamalon.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="NOMBRE" />
        <EditText android:id="@+id/personal_name" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:paddingHorizontal="14dp" android:text="" android:textColor="@color/tamalon_ink" android:textSize="11sp" />
        <TextView style="@style/Tamalon.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="CORREO" />
        <EditText android:id="@+id/personal_email" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" android:text="" android:textColor="@color/tamalon_ink" android:textSize="11sp" />
        <TextView style="@style/Tamalon.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="TELÉFONO" />
        <EditText android:id="@+id/personal_phone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:inputType="phone" android:paddingHorizontal="14dp" android:text="" android:textColor="@color/tamalon_ink" android:textSize="11sp" />
        <android.widget.Button android:id="@+id/save_personal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="18dp" android:background="@drawable/bg_button" android:text="GUARDAR CAMBIOS" android:textColor="@color/tamalon_field_text" android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
