<?xml version="1.0" encoding="utf-8"?>
<!-- Gestión de rutas del Vendedor (RF13): trazar, guardar, editar y eliminar rutas por día. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tamalon_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal"
            android:paddingTop="@dimen/screen_top"
            android:paddingBottom="108dp">

            <!-- Encabezado -->
            <LinearLayout
                style="@style/Tamalon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="Rutas"
                        android:padding="8dp"
                        android:src="@drawable/ic_navigation" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Tamalon.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis rutas"
                            android:textColor="@color/tamalon_ink"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Tamalon.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Traza y organiza recorridos por día de la semana"
                            android:textColor="@color/tamalon_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/routes_counter_badge"
                        style="@style/Tamalon.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="0 de 3 rutas"
                        android:textColor="@color/tamalon_field_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <android.widget.Button
                    android:id="@+id/routes_btn_add"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/inter"
                    android:text="+ Trazar nueva ruta"
                    android:textAllCaps="false"
                    android:textColor="@color/tamalon_field_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bloqueo para cuenta gratuita -->
            <LinearLayout
                android:id="@+id/routes_premium_lock"
                style="@style/Tamalon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone">

                <TextView
                    style="@style/Tamalon.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rutas programadas (Premium)"
                    android:textColor="@color/tamalon_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Tamalon.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Traza, guarda, edita y asigna hasta 3 rutas semanales con Tamalón Premium."
                    android:textColor="@color/tamalon_muted"
                    android:textSize="9.5sp" />

                <android.widget.Button
                    android:id="@+id/routes_btn_upgrade"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_premium"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/inter"
                    android:paddingHorizontal="18dp"
                    android:text="Ver beneficios de Premium"
                    android:textAllCaps="false"
                    android:textColor="@color/tamalon_premium_foreground"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Editor / Trazado de ruta -->
            <LinearLayout
                android:id="@+id/routes_form_panel"
                style="@style/Tamalon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/routes_form_title"
                    style="@style/Tamalon.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva ruta"
                    android:textColor="@color/tamalon_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/routes_points_info"
                    style="@style/Tamalon.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Toca el mapa para trazar los puntos de tu recorrido (mín. 2)"
                    android:textColor="@color/tamalon_muted"
                    android:textSize="9sp" />

                <FrameLayout
                    android:id="@+id/routes_map_container"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_surface_card" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <android.widget.Button
                        android:id="@+id/routes_btn_undo_point"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:backgroundTint="@null"
                        android:text="Quitar último punto"
                        android:textAllCaps="false"
                        android:textColor="@color/tamalon_field_text"
                        android:textSize="9sp" />

                    <android.widget.Button
                        android:id="@+id/routes_btn_clear_points"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:backgroundTint="@null"
                        android:text="Limpiar trazado"
                        android:textAllCaps="false"
                        android:textColor="@color/tamalon_error"
                        android:textSize="9sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/routes_form_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nombre de la ruta (ej. Centro y Mercado)"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:padding="10dp"
                    android:textColor="@color/tamalon_ink"
                    android:textColorHint="@color/tamalon_muted"
                    android:textSize="10.5sp" />

                <EditText
                    android:id="@+id/routes_form_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Horario (ej. 08:00 a 13:00)"
                    android:inputType="text"
                    android:maxLength="40"
                    android:padding="10dp"
                    android:textColor="@color/tamalon_ink"
                    android:textColorHint="@color/tamalon_muted"
                    android:textSize="10.5sp" />

                <TextView
                    style="@style/Tamalon.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Día de la semana"
                    android:textColor="@color/tamalon_field_text" />

                <LinearLayout
                    android:id="@+id/routes_days_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/routes_form_error"
                    style="@style/Tamalon.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="@color/tamalon_error"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <android.widget.Button
                        android:id="@+id/routes_form_cancel"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_surface_card"
                        android:backgroundTint="@null"
                        android:text="@string/btn_cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/tamalon_field_text"
                        android:textSize="10sp" />

                    <android.widget.Button
                        android:id="@+id/routes_form_save"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="@null"
                        android:text="Guardar ruta"
                        android:textAllCaps="false"
                        android:textColor="@color/tamalon_field_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Tamalon.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="RUTAS GUARDADAS" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/routes_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/routes_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_empty"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Sin rutas"
                    android:src="@drawable/ic_navigation" />

                <TextView
                    style="@style/Tamalon.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="No hay rutas programadas"
                    android:textColor="@color/tamalon_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Tamalon.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Toca «+ Trazar nueva ruta» para dibujar tu recorrido y asignarlo a un día."
                    android:textColor="@color/tamalon_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="16dp" />
</FrameLayout>
